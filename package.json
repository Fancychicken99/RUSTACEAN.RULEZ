{
  "name": "rustacean-crm-build",
  "version": "0.1.0",
  "private": true,
  "description": "Development-only native packaging tools; Node is not an application runtime dependency.",
  "scripts": {
    "tauri": "tauri",
    "package:windows": "tauri build --bundles nsis -- --locked",
    "package:macos": "tauri build --target universal-apple-darwin --bundles app,dmg -- --locked"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
