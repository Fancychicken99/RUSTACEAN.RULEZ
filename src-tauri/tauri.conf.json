{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hippo Harbor CRM",
  "version": "0.2.1",
  "identifier": "edu.rustacean.crm",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hippo Harbor CRM",
        "url": "index.html",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "resources": {
      "resources/voice/": "resources/voice/"
    },
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Offline contractor relationship management",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
