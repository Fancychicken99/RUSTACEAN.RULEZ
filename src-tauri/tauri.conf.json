{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustacean CRM",
  "version": "0.1.0",
  "identifier": "edu.rustacean.crm",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Northstar CRM",
        "url": "index.html",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Offline fictional contractor CRM",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
